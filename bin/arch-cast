#!/bin/sh
# Development convenience only. Installation copies the native binary itself.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
if [ ! -x "$root/target/release/arch-cast" ]; then
    printf '%s\n' 'Build first: cargo build --release --locked -j 2' >&2
    exit 1
fi
exec "$root/target/release/arch-cast" "$@"
